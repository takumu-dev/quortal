<?xml version="1.0"?>
<!--
  quortal, for NetRadiant-custom. Its engine path is the folder that holds
  quortal and its game folder, such as build/Release in quortal's source.
  The paks in the game folder, OpenArena's and quortal.pk3, give the
  textures and shaders, and gamepacks/quortal.game/quortal the entities
-->
<game
  type="q3"
  index="1"
  name="quortal"
  enginepath_win32="C:/Program Files/quortal/"
  enginepath_linux="/usr/local/games/quortal/"
  enginepath_macos="/Applications/quortal/"
  engine_win32="quortal.exe"
  engine_linux="quortal.x86_64"
  engine_macos="quortal.app"
  basegame="quortal"
  basegamename="quortal"
  unknowngamename="Custom quortal modification"
  shaderpath="scripts"
  archivetypes="pk3"
  texturetypes="tga jpg png"
  modeltypes="*"
  soundtypes="wav ogg"
  maptypes="mapq3"
  shaders="quake3"
  entityclass="quake3"
  entityclasstype="xml"
  entities="quake3"
  brushtypes="quake3"
  patchtypes="quake3"
  default_scale="0.5"
  q3map2_type="quake3"
  no_patch="0"
  common_shaders_name="Common"
  common_shaders_dir="common/"
  no_bsp_monitor="0"
  shader_trigger="textures/common/trigger"
/>
